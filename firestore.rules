rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Note: We don't use groupExists() for non-members because exists() requires read permission.
    // Instead, we trust that if a join code exists, the group exists (join codes are cleaned up on delete).
    function isGroupMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // FP/MMR state is SERVER-OWNED (consolidated 2026-07-22): the only scorer
    // is functions/mmr-compute.js (+ mmr-season.js), reached via the 6h
    // schedule or the recomputeMyMmr callable. These keys on users/{uid} are
    // what the scorer maintains — clients may never change them, or they could
    // hand themselves FP.
    function lockedMmrKeys() {
      return ['mmr', 'mp', 'rankTier', 'rankDivision',
              'prevMmr', 'prevRankTier', 'prevRankDivision',
              'streakWeeks', 'streakFreezes', 'tierShieldWeeksRemaining',
              'consecutiveMissedWeeks', 'lastWeekIdUpdated', 'seasonPeak',
              'hardModeWeeks', 'firstWeekId', 'currentSeasonId',
              'lastSeasonRolledFrom', 'lastSeasonRolledTo', 'seasonRolledAt'];
    }

    // User profile documents: users/{uid}
    // Contains profile data, onboarding status, goals, and preferences.
    // Onboarding fields: onboarding.completed, onboarding.version, onboarding.startedAt, onboarding.completedAt, onboarding.lastStep
    // Profile fields: displayName, username, sex, age, height, weightCurrent, weightGoal, weightTargetDate, units, goalMode
    // Goal fields: dailyCalorieGoal, workoutsPerWeek (can be null if workouts disabled)
    // Tracking preferences: logCaloriesDaysPerWeek, logWeightDaysPerWeek (can be null if tracking disabled)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Create: the signup seed may include starting rank fields, but ONLY at
      // the starting values (Silver IV / 1800) and never the scorer's anchor
      // or streak state — otherwise delete-and-recreate would be an FP exploit.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(
             ['streakWeeks', 'streakFreezes', 'tierShieldWeeksRemaining',
              'consecutiveMissedWeeks', 'lastWeekIdUpdated', 'seasonPeak',
              'hardModeWeeks', 'firstWeekId', 'currentSeasonId',
              'lastSeasonRolledFrom', 'lastSeasonRolledTo', 'seasonRolledAt'])
        && request.resource.data.get('mmr', 1800) == 1800
        && request.resource.data.get('prevMmr', 1800) == 1800
        && request.resource.data.get('mp', 0) == 0;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedMmrKeys());
      // No client deletes (nothing in the app deletes the user doc; allowing
      // it would reopen the recreate loophole).
      allow delete: if false;
      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Deleted health-synced log ids — sync skips (and re-deletes) these so
      // a user's delete of an imported workout can't be resurrected.
      match /healthTombstones/{logId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /weights/{entryId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /workouts/{entryId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Global MMR system (v1 beta): private per-user state + inputs.
      match /goals/{goalId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Weekly scoring docs are the scorer's ANCHOR CHAIN (mmrBefore /
      // streakBefore / ... baselines) — server-written only. The single client
      // write that remains is the vacation flag (services/vacation.ts).
      match /weekly/{weekId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['vacation', 'vacationSetAt']);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vacation', 'vacationSetAt']);
        allow delete: if false;
      }
      // Daily calorie adherence toggle: users/{uid}/calorieDays/{YYYY-MM-DD}
      match /calorieDays/{dateId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Earned badges + season snapshots (private, v1 beta)
      match /badges/{badgeId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /seasonResults/{seasonId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Per-season snapshot (legacy-spec aligned): users/{uid}/seasons/{seasonId}
      match /seasons/{seasonId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Health & Fitness integration settings: users/{uid}/healthSettings/{settingsId}
      match /healthSettings/{settingsId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Activity feed (cheers/nudges received, rank changes). The owner reads +
      // marks read; the Cloud Function writes via admin (bypasses rules).
      match /activity/{activityId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Daily FP ledger: users/{uid}/fpDaily/{YYYY-MM-DD} — written ONLY by
      // updateMmrScheduled (admin). Read-only to the owner; deny client writes
      // so the FP-based Yesterday's Champion ranking can't be gamed.
      match /fpDaily/{dateId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Global season metadata (for countdown / UI). Any signed-in user can read.
    // In beta, allow create by any signed-in user; updates/deletes only by the creator.
    match /globalSeasons/{seasonId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Public user profiles, readable only if the viewer shares a group with the target user.
    // The “shared group” check reads a per-viewer visibility index maintained by
    // the syncVisibility Cloud Function on group member join/leave.
    match /publicUsers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid ||
        exists(/databases/$(database)/documents/visibility/$(request.auth.uid)/canSee/$(uid)));
      // The public FP mirror is server-owned like users/{uid}'s mmr state.
      // Signup may seed it, but only at the starting values.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['prevMmrPublic', 'seasonIdPublic'])
        && request.resource.data.get('mmrPublic', 1800) == 1800
        && request.resource.data.get('mpPublic', 0) == 0;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
             ['mmrPublic', 'rankTierPublic', 'rankDivisionPublic', 'mpPublic',
              'prevMmrPublic', 'seasonIdPublic']);
      allow delete: if false;

      // Shareable FP history subset — mirrored ONLY by the server compute
      // since 2026-07-22 (the owner's client used to write it too).
      match /weeklyPublic/{weekId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/visibility/$(request.auth.uid)/canSee/$(uid)));
        allow write: if false;
      }
    }

    // Per-viewer visibility index: visibility/{viewerUid}/canSee/{targetUid}.
    // Server-written ONLY (syncVisibility function; admin bypasses rules).
    // Client writes used to be allowed here, which let any signed-in user
    // grant themselves canSee on ANY uid and read any profile.
    match /visibility/{viewerUid}/canSee/{targetUid} {
      allow read: if signedIn() && request.auth.uid == viewerUid;
      allow write: if false;
    }

    // Social-push queue: the app enqueues a cheer/nudge here; a Cloud Function
    // (admin) reads it, sends the push, and deletes it. Clients may only CREATE
    // their own outgoing items and never read the queue (recipients' push tokens
    // stay private, read only by the function).
    match /pushQueue/{id} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && (request.resource.data.type == 'cheer'
            || request.resource.data.type == 'nudge'
            || request.resource.data.type == 'reaction')
        // Optional hype variant id. Only an ID is accepted — never copy — and
        // the function validates it against the server catalog before use.
        && (!('hypeId' in request.resource.data)
            || (request.resource.data.hypeId is string
                && request.resource.data.hypeId.size() <= 24));
      allow read, update, delete: if false;
    }

    // App-level remote config (update banner, kill switches) — admin-written only.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Push delivery failures by error code (written by push-helper via admin).
    // Server-only: a doc here means a CLASS of delivery is broken, e.g. the
    // InvalidCredentials outage that killed all Android push for weeks.
    match /pushFailures/{code} {
      allow read, write: if false;
    }

    // In-app poll answers: pollResponses/{pollId}_{uid}.
    // The doc id encodes the answerer, so one-response-per-person is enforced
    // by the id itself rather than a read-then-write race (same trick as
    // signatures). Answers are NOT readable by clients — results are for admin
    // tooling, and a visible tally would bias later answers.
    match /pollResponses/{responseId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pollId is string
        && responseId == request.resource.data.pollId + '_' + request.auth.uid
        && request.resource.data.optionId is string
        && request.resource.data.optionId.size() <= 40;
      // Answers can be CHANGED (people reconsider) but only your own, and the
      // id keeps it to one row per person.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionId', 'answeredAt']);
      allow read, delete: if false;
    }

    // Client JS error reports (errorReporter.ts). Create-only: clients can
    // file a report but never read/alter the collection (viewed via console
    // or admin scripts).
    match /clientErrors/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Join-code lookup table so non-members can join without reading all groups.
    // get-only: `read` would also allow LISTING the collection, letting anyone
    // harvest every group's code. The app only ever looks up exact codes.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Username uniqueness collection: usernames/{normalizedUsername}
    // Users can create a username if it doesn't exist, and read their own username.
    match /usernames/{normalizedUsername} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      // Username updates/deletes are not allowed (usernames are permanent)
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn();
      function isGroupMetaUpdate() {
        // Allow members to update only these metadata fields.
        return request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberCount', 'lastActivityAt', 'updatedAt']);
      }
      function isGroupSettingsUpdate() {
        // Allow admins to update lightweight settings (streak rule + challenge).
        return request.resource.data.diff(resource.data).changedKeys().hasOnly(['streakRule', 'challenge', 'updatedAt']);
      }
      allow update: if (signedIn() && request.auth.uid == resource.data.createdBy) ||
        (isGroupMember(groupId) && isGroupMetaUpdate()) ||
        (isGroupAdmin(groupId) && isGroupSettingsUpdate()) ||
        // Allow non-members to update metadata when joining (incrementing memberCount)
        // Note: We don't check groupExists() here because exists() requires read permission.
        // If the join code exists, the group exists (join codes are cleaned up on delete).
        (signedIn() && isGroupMetaUpdate());
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /members/{uid} {
        // Allow users to read their own membership document (needed for join check)
        // Also allow any group member to read all members (for member lists)
        allow read: if signedIn() && (request.auth.uid == uid || isGroupMember(groupId));
        // Allow creating membership when joining (group existence validated via join code)
        // Note: We don't check groupExists() because exists() requires read permission.
        // If the join code exists, the group exists (join codes are cleaned up on delete).
        allow create: if signedIn() && request.auth.uid == uid;
        // A user manages their own membership; a group admin may also update
        // (promote/demote) or delete (remove) any member EXCEPT the creator.
        allow update, delete: if signedIn() && (
          request.auth.uid == uid ||
          (isGroupAdmin(groupId) && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy != uid)
        );
      }

      match /logs/{logId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        // The log owner may edit/delete their log. Any group member may update
        // ONLY the `reactions` map (cheers) on another member's log.
        allow update: if signedIn() && (
          request.auth.uid == resource.data.uid ||
          (isGroupMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        );
        allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      }

      match /goals/{uid} {
        allow read: if isGroupMember(groupId);
        allow write: if signedIn() && request.auth.uid == uid && isGroupMember(groupId);
      }

      // Per-group announcement queue — celebrations (goal completions, tier
      // jumps) belong to ONE group, not the whole app. config/app stays for
      // genuine app-wide news only.
      //
      // WHY: a single global queue meant the day a second group existed, one
      // crew's celebration would pop up on a stranger's phone. Server-written
      // only (functions/celebrations.js via admin).
      match /announcements/{annId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Weekly commitment signatures: groups/{gid}/signatures/{weekId}_{uid}.
      // CREATE-ONLY by the signer — a signature you can retract isn't a
      // commitment, so update/delete are denied outright (no un-signing, no
      // editing someone else's). Purely symbolic: the scorer never reads this.
      match /signatures/{sigId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && sigId == request.resource.data.weekId + '_' + request.auth.uid
          && request.resource.data.weekId is string;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        // The author may edit their own message. Any group member may update
        // ONLY the `reactions` map — same shape as logs, so milestone cards
        // (server-posted, uid 'system') can be cheered by the whole crew.
        allow update: if signedIn() && (
          request.auth.uid == resource.data.uid ||
          (isGroupMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        );
        allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      }

      match /issues/{issueId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        // Only admins can toggle resolved status
        allow update: if isGroupAdmin(groupId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedAt']);
        allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      }
    }
  }
}


