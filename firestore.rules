rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Join-code lookup table so non-members can join without reading all groups.
    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == request.resource.data.createdBy;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /members/{uid} {
        allow read: if isGroupMember(groupId);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /logs/{logId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update, delete: if signedIn() && request.auth.uid == resource.data.uid;
      }

      match /goals/{uid} {
        allow read: if isGroupMember(groupId);
        allow write: if signedIn() && request.auth.uid == uid && isGroupMember(groupId);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update, delete: if signedIn() && request.auth.uid == resource.data.uid;
      }
    }
  }
}


