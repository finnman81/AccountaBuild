{
  "expo": {
    "name": "AccountaBuild",
    "slug": "accountabuild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accountabuild.app",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "AccountaBuild needs access to your health data to automatically sync workouts, calories, and weight from Apple Health.",
        "NSHealthUpdateUsageDescription": "AccountaBuild needs permission to read your health data from Apple Health."
      },
      "notificationMode": "production"
    },
    "android": {
      "package": "com.accountabuild.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1b2a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "healthSharePermission": "AccountaBuild needs access to your health data to automatically sync workouts, calories, and weight from Apple Health.",
          "healthUpdatePermission": "AccountaBuild needs permission to read your health data from Apple Health."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2eb5bba7-f824-45c6-8d64-28aa2ab30d60"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2eb5bba7-f824-45c6-8d64-28aa2ab30d60",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
