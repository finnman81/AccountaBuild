# This file serves as an example for the required environment variables.
# Copy this file to .env and fill in the actual values.

# Database
# Connection string for your PostgreSQL database.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/accountabuild?schema=public"

# JWT
# A strong, secret key for signing authentication tokens.
# You can generate one using: openssl rand -base64 32
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# Node Environment
# Set to "development" or "production".
NODE_ENV="development"

# CORS
# The base URL of your frontend application.
FRONTEND_URL="http://localhost:3000"

# AWS S3
# The name of the S3 bucket used for file uploads.
S3_BUCKET_NAME="YOUR_S3_BUCKET_NAME"
# The AWS region where the bucket is located.
AWS_REGION="us-east-1"
# Your AWS Access Key ID and Secret Access Key (optional, can be handled by instance roles)
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# AWS SNS Platform Application ARNs for Push Notifications
SNS_IOS_PLATFORM_APPLICATION_ARN="YOUR_IOS_SNS_PLATFORM_ARN"
SNS_ANDROID_PLATFORM_APPLICATION_ARN="YOUR_ANDROID_SNS_PLATFORM_ARN"
